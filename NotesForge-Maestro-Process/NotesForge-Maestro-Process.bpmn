<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:uipath="http://uipath.org/schema/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="UiPath Maestro (https://uipath.com)">
  <bpmn:process id="Process_1" name="NotesForge Notes Process">
    <bpmn:extensionElements>
      <uipath:variables version="v1">
        <uipath:input id="input_Request" name="request" type="json" elementId="Event_start" />
        <uipath:inputOutput id="Var_Request" name="Request" type="json" elementId="Process_1" />
        <uipath:inputOutput id="Var_JobResponse" name="AgentResponse" type="json" elementId="Process_1" />
        <uipath:inputOutput id="Var_Notes" name="Notes" type="json" elementId="Process_1" />
        <uipath:output id="output_Notes" name="notes" type="json" elementId="End_complete" />
      </uipath:variables>
      <uipath:bindings version="v1">
        <uipath:binding id="Binding_AgentName" name="name" type="string" resource="process" resourceSubType="Agent" propertyAttribute="name" resourceKey="NotesForge.AI.agent.NotesForge.Processing.Worker" default="NotesForge Processing Worker" />
        <uipath:binding id="Binding_AgentFolder" name="folderPath" type="string" resource="process" resourceSubType="Agent" propertyAttribute="folderPath" resourceKey="NotesForge.AI.agent.NotesForge.Processing.Worker" default="solution_folder" />
      </uipath:bindings>
    </bpmn:extensionElements>
    <bpmn:startEvent id="Event_start" name="Submit study material">
      <bpmn:extensionElements>
        <uipath:entryPointId value="0c9f18d6-861f-4b29-9ef9-02f8fe112b07" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
          <uipath:output name="request" type="json" var="Var_Request" source="=vars.input_Request" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_start_agent</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_analyze_documents" name="Analyze documents and create notes">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.StartAgentJob" version="v2" />
          <uipath:context>
            <uipath:input name="name" type="string" value="=bindings.Binding_AgentName" />
            <uipath:input name="folderPath" type="string" value="=bindings.Binding_AgentFolder" />
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{"documents":"=vars.Var_Request.documents","notesStyle":"=vars.Var_Request.notesStyle","detailLevel":"=vars.Var_Request.detailLevel","outputLanguage":"=vars.Var_Request.outputLanguage","includePageReferences":"=vars.Var_Request.includePageReferences"}]]></uipath:input>
          <uipath:output name="Process response" type="Orchestrator.RunJob" var="Var_JobResponse" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_agent</bpmn:incoming>
      <bpmn:outgoing>Flow_agent_complete</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_complete" name="Return notes">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
          <uipath:output name="notes" type="json" var="output_Notes" source="=vars.Var_Notes" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_agent_complete</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_store_notes" name="Store agent response">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
          <uipath:output name="Notes" type="json" var="Var_Notes" source="=vars.Var_JobResponse" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_agent_complete</bpmn:incoming>
      <bpmn:outgoing>Flow_notes_complete</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_start_agent" sourceRef="Event_start" targetRef="Task_analyze_documents" />
    <bpmn:sequenceFlow id="Flow_agent_complete" sourceRef="Task_analyze_documents" targetRef="Task_store_notes" />
    <bpmn:sequenceFlow id="Flow_notes_complete" sourceRef="Task_store_notes" targetRef="End_complete" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="S_End_complete" bpmnElement="End_complete"><dc:Bounds x="638" y="214" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Event_start" bpmnElement="Event_start"><dc:Bounds x="252" y="214" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_analyze_documents" bpmnElement="Task_analyze_documents"><dc:Bounds x="338" y="192" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_store_notes" bpmnElement="Task_store_notes"><dc:Bounds x="488" y="192" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E_Flow_agent_complete" bpmnElement="Flow_agent_complete"><di:waypoint x="438" y="232" /><di:waypoint x="488" y="232" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_notes_complete" bpmnElement="Flow_notes_complete"><di:waypoint x="588" y="232" /><di:waypoint x="638" y="232" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_start_agent" bpmnElement="Flow_start_agent"><di:waypoint x="288" y="232" /><di:waypoint x="338" y="232" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
