              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "notesMarkdown": {
              "type": "string"
            }
          }
        },
        "binding": {
          "nodeId": "generateNotes",
          "outputId": "output"
        }
      },
      {
        "id": "generateNotes.error",
        "type": "object",
        "description": "Error information if the node fails",
        "schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "required": [
            "code",
            "message",
            "detail",
            "category",
            "status"
          ],
          "properties": {
            "code": {
              "type": "string",
              "description": "Error code as a string"
            },
            "message": {
              "type": "string",
              "description": "High-level error message"
            },
            "detail": {
              "type": "string",
              "description": "Detailed error description"
            },
            "category": {
              "type": "string",
