      "form": {
        "id": "connector-properties",
        "title": "Connector configuration",
        "sections": [
          {
            "id": "connector",
            "title": "Connector",
            "collapsible": true,
            "defaultExpanded": true,
            "fields": [
              {
                "label": "",
                "name": "inputs.detail",
                "type": "custom",
                "component": "dap-config",
                "componentProps": {
                  "connectorDetail": {
                    "type": "Integrated",
                    "packageId": "211594",
                    "svgIconUrl": "icons/1177fb24ca64146fbb9be417dffa2b01231e5947ab25a506cee199f7ca84dd97.svg",
                    "displayName": "HTTP Webhook",
                    "assemblyQualifiedName": "UiPath.IntegrationService.Activities.Runtime.Activities.ConnectorTriggerActivity, UiPath.IntegrationService.Activities.Runtime, Version=1.30.0.0, Culture=neutral, PublicKeyToken=null",
                    "description": "Triggers instantly when an event has occured",
                    "category": "HTTP Webhook.Triggers",
                    "activityColor": "#000000",
                    "configuration": "{\"connectorKey\":\"uipath-http-webhook\",\"objectName\":\"HTTP_WEBHOOK\",\"activityType\":\"CuratedTrigger\",\"version\":\"1.0.0\",\"eventOperation\":\"GENERIC\",\"eventMode\":\"webhooks\",\"supportsStreaming\":false}",
                    "uiPathActivityTypeId": "773cab30-51dc-3eb4-b19d-720dfa151cc9",
                    "isExperimental": false,
                    "helpUrlTemplate": "https://docs.uipath.com/{0}/activities/other/latest/integration-service/uipath-http-webhook-HTTP-Webhook",
                    "isEnabled": true,
                    "targetPlatform": "CrossPlatform",
