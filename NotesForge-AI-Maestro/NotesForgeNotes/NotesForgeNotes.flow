          }
        }
      },
      "inputs": {
        "script": "\n        const request = JSON.parse($vars.start.output.request_body || \"{}\");\n        return {\n          topic: String(request.topic || \"Untitled topic\"),\n          content: String(request.content || \"\"),\n          style: String(request.style || \"Structured\"),\n        };\n      "
      }
