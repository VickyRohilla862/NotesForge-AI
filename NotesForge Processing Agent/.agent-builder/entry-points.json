{
  "$schema": "https://cloud.uipath.com/draft/2024-12/entry-point",
  "$id": "entry-points.json",
  "entryPoints": [
    {
      "filePath": "/content/agent.json",
      "uniqueId": "168fae3d-4042-4abb-ae54-0d640d56c19d",
      "type": "agent",
      "input": {
        "type": "object",
        "properties": {
          "documents": {
            "type": "array",
            "description": "PDFs and images supplied for this run.",
            "items": {
              "$ref": "#/definitions/job-attachment"
            }
          },
          "notesStyle": {
            "type": "string",
            "description": "Notes style: study, executive, or meeting.",
            "enum": [
              "study",
              "executive",
              "meeting"
            ],
            "default": "study"
          },
          "detailLevel": {
            "type": "string",
            "description": "Requested detail level.",
            "enum": [
              "brief",
              "standard",
              "detailed"
            ],
            "default": "standard"
          },
          "outputLanguage": {
            "type": "string",
            "description": "Requested output language.",
            "default": "English"
          },
          "includePageReferences": {
            "type": "boolean",
            "description": "Include page references when supported by the source.",
            "default": true
          }
        },
        "required": [
          "documents"
        ],
        "definitions": {
          "job-attachment": {
            "type": "object",
            "properties": {
              "ID": {
                "type": "string",
                "description": "Orchestrator attachment key"
              },
              "FullName": {
                "type": "string",
                "description": "File name"
              },
              "MimeType": {
                "type": "string",
                "description": "MIME type, e.g. application/pdf or image/png"
              },
              "Metadata": {
                "type": "object",
                "description": "Dictionary<string, string> of metadata",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "ID"
            ],
            "x-uipath-resource-kind": "JobAttachment"
          }
        }
      },
      "output": {
        "type": "object",
        "properties": {
          "notesUsable": {
            "type": "boolean",
            "description": "Whether the supplied files produced usable notes."
          },
          "title": {
            "type": "string",
            "description": "Title for the notes document."
          },
          "overview": {
            "type": "string",
            "description": "Short overview of the supplied material."
          },
          "sources": {
            "type": "array",
            "description": "Notes organized by source file.",
            "items": {
              "type": "object",
              "properties": {
                "filename": {
                  "type": "string"
                },
                "summary": {
                  "type": "string"
                },
                "notes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "key_terms": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "page_references": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "uncertainties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "filename",
                "summary",
                "notes",
                "key_terms",
                "page_references",
                "uncertainties"
              ]
            }
          },
          "cross_source_takeaways": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "actions_or_questions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  ]
}
